{
  "name": "moto-routes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Moto Routes monorepo — documentación transversal (VitePress + TypeDoc + cargo doc) y gestión de hooks Git.",
  "scripts": {
    "prepare": "husky",
    "docs:api": "typedoc",
    "docs:coverage": "typedoc && node scripts/docs-coverage.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:prepare": "node scripts/docs-prepare.mjs",
    "docs:rust": "cd apps/mobile/src-tauri && cargo doc --no-deps",
    "docs": "pnpm docs:prepare && pnpm docs:api && pnpm docs:rust && pnpm docs:build"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "vitepress": "1.6.4"
  }
}
