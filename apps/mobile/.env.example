# Copiar a .env.local (no versionado, ver .gitignore) para apuntar a un host
# real de apps/api. El único valor versionado aquí es el de desarrollo local.
# Para producción, el host real (interfaz Tailscale del servidor) NUNCA va en
# un fichero versionado — este repo es público. Ver ADR-035.
VITE_API_BASE_URL=http://localhost:8080
