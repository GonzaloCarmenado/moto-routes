{
  "name": "moto-routes-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ride Tracker Mobile App - GPS route recording for motorcyclists",
  "scripts": {
    "dev": "node scripts/kill-port.mjs && vite",
    "dev:kill": "node scripts/kill-port.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:android:init": "tauri android init",
    "rust:test": "cd src-tauri && cargo test",
    "rust:lint": "cd src-tauri && cargo clippy -- -D warnings",
    "rust:format": "cd src-tauri && cargo fmt --check",
    "rust:audit": "cd src-tauri && cargo audit",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test dev http://localhost:1420 cy:run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "exifr": "^7.1.3",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.0.0",
    "cypress": "^15.19.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "start-server-and-test": "^3.0.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
