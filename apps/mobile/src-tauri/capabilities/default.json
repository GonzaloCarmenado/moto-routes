{
  "identifier": "default",
  "description": "Default capabilities with minimal permissions for Moto Routes",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "notification:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/photos" }, { "path": "$APPDATA/photos/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/photos" }, { "path": "$APPDATA/photos/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/photos/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/photos/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/photos/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/repos/crzverde/moto-routes/releases/latest" },
        { "url": "https://github.com/crzverde/moto-routes/releases/download/*" },
        { "url": "https://release-assets.githubusercontent.com/*" }
      ]
    }
  ]
}
