{
  "name": "moto-routes-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Moto Routes - panel web interno (reporting y herramientas operativas)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test dev http://localhost:4200 cy:run"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.0.0",
    "cypress": "^15.19.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsdoc": "^63.3.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "start-server-and-test": "^3.0.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
