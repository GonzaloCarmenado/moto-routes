.vscode/
.idea/
*.swp
*.swo

# Cypress
apps/mobile/cypress/screenshots/
apps/mobile/cypress/videos/
apps/mobile/cypress/downloads/
apps/web/cypress/screenshots/
apps/web/cypress/videos/
