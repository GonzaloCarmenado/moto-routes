# Documentación generada
docs/api/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/reference/

# Datos OSM procesados para OSRM (normalizar-y-exportar-rutas) — varios GB,
# se regeneran con infra/docker/osrm/prepare-osm-data.sh, ver su README.md.
infra/docker/osrm/data/

# Docker (infra/docker) — credenciales de desarrollo local, ver .env.example
infra/docker/.env
# Credenciales del servidor de producción, ver .env.prod.example (despliegue-servidor-tailscale)
infra/docker/.env.prod

# apps/mobile: host real de apps/api en producción (ver .env.example, catalogo-tipos-parada/ADR-035)
# — nunca en un fichero versionado, el repo es público.
apps/mobile/.env.local
apps/mobile/.env.*.local
# Override local de tauri.conf.json para el build de producción (CSP con el host real).
apps/mobile/src-tauri/tauri.conf.prod.local.json

# OS
Thumbs.db
Desktop.ini

# scripts/pull-db.ps1 export
moto-routes-export.db

# scripts/deploy-prod.sh — datos de conexión al servidor de producción (host/usuario/URL),
# no versionados por ser repo público (ver ADR-033/035, hardening-despliegue-servidor).
scripts/.env.deploy.local
