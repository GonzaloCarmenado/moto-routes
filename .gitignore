# target/ (build output de Maven, apps/api) — sin `/` intermedio, cubre cualquier profundidad
target/
*.local
*.log
.DS_Store
*.apk
*.aab
*.so
rustup-init.exe

# Android (Tauri generated) — rutas con `/` intermedio ancladas a la raíz,
# prefijadas con apps/mobile/ tras el monorepo (ver ADR-032)
apps/mobile/src-tauri/gen/android/build/
apps/mobile/src-tauri/gen/android/.gradle/
apps/mobile/src-tauri/gen/android/local.properties
apps/mobile/src-tauri/gen/android/app/build/
apps/mobile/src-tauri/gen/android/app/src/main/jniLibs/
# Config del proyecto Firebase (notificaciones-push-fcm) — no es un secreto según
# Google, pero el repo es público y no aporta nada versionarla: cada dev pone su
# copia local, CI la inyecta desde un secret (ver .github/workflows/ci.yml).
apps/mobile/src-tauri/gen/android/app/google-services.json

