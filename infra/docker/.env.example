# Copiar a .env (no versionado, ver .gitignore) y ajustar si hace falta.
# Valores solo de desarrollo local: postgres únicamente es alcanzable dentro
# de la red interna de Docker Compose, nunca expuesto en un despliegue real.
POSTGRES_DB=motoroutes
POSTGRES_USER=motoroutes
POSTGRES_PASSWORD=motoroutes
# Firma los tokens de sesión (JWT) de apps/api. Valor trivial solo para
# desarrollo local — en producción vive únicamente en infra/docker/.env.prod.
AUTH_TOKEN_SECRET=local-dev-secret-not-for-prod
# Envío de emails de verificación vía Resend (ver openspec/changes/confirmacion-email-usuarios).
# Con una clave de pruebas o inválida el envío simplemente falla (best-effort,
# no bloquea registro/login salvo el propio login exigir verificación) — no
# hace falta una cuenta real de Resend para desarrollar en local.
RESEND_API_KEY=local-dev-key-not-for-prod
RESEND_FROM_ADDRESS=Moto Routes <dev@localhost>
# URL pública y absoluta (https://) desde la que se construyen los enlaces de
# verificación de email. En local no es alcanzable de verdad; solo debe
# empezar por https:// para que config.Load() la acepte (ver ADR-036: una URL
# rota aquí es exactamente el incidente que causó la release v0.1.0 rota).
PUBLIC_API_BASE_URL=https://localhost
# Fotos de ruta (ver openspec/changes/almacenamiento-fotos-backend). MinIO
# solo alcanzable dentro de la red interna de Docker Compose.
MINIO_ROOT_USER=motoroutes
MINIO_ROOT_PASSWORD=motoroutes123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=motoroutes
MINIO_SECRET_KEY=motoroutes123
MINIO_BUCKET=images
# Clave AES-256 de cifrado de fotos — 32 bytes exactos codificados en base64.
# Generar una propia para desarrollo local, p. ej.:
#   openssl rand -base64 32
PHOTO_ENCRYPTION_KEY=
# Notificaciones push vía FCM (ver openspec/changes/notificaciones-push-fcm).
# JSON completo de la cuenta de servicio de Firebase, en una sola línea.
# Opcional: sin ella, el backend arranca igual con un Notifier no-op (log al
# arrancar) — no hace falta un proyecto Firebase real para desarrollar en local.
FCM_SERVICE_ACCOUNT_JSON=
# Normalización de puntos GPS vía OSRM (ver openspec/changes/normalizar-y-exportar-rutas).
# URL del servicio osrm de este mismo docker-compose.yml. Opcional: sin ella,
# la normalización queda desactivada (best-effort) — no hace falta procesar
# el extracto OSM para desarrollar en local. Ver infra/docker/osrm/README.md.
MAPMATCH_OSRM_URL=http://osrm:5000
# Observabilidad (ver openspec/changes/observabilidad-produccion). Valores
# triviales solo para desarrollo local — en producción viven únicamente en
# infra/docker/.env.prod.
ADMIN_STATUS_TOKEN=local-dev-admin-token-not-for-prod
RESEND_WEBHOOK_SECRET=local-dev-webhook-secret-not-for-prod
# EVENTS_LOG_PATH, EVENTS_LOG_MAX_SIZE_BYTES, SYSMETRICS_PATH y
# SYSMETRICS_ALERT_THRESHOLD_PERCENT no hace falta fijarlos en local: usan un
# valor por defecto razonable (fichero relativo al directorio de trabajo,
# 10 MiB, 90%).
