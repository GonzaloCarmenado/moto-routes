{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Moto Routes",
  "version": "0.1.0",
  "identifier": "com.motoroutes.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Moto Routes",
        "width": 400,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost https://tiles.openfreemap.org; connect-src 'self' ipc: http://ipc.localhost https://tiles.openfreemap.org https://vpic.nhtsa.dot.gov; worker-src 'self' blob:; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/photos/*", "$APPDATA/photos/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}